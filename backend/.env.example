# ==============================================================================
# Agri-SAGE Backend Environment Configuration Example
# Copy this file to .env inside the backend/ directory
# ==============================================================================

# 1. Database Configuration
DATABASE_URL=postgresql+asyncpg://agrisage:agrisage_secure_password_2026@localhost:5432/agrisage_dev

# 2. Authentication & Security
SECRET_KEY=super_secret_jwt_key_agrisage_2026_minimum_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 3. Environment & Operational Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_IMAGE_SIZE_MB=5
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# 4. Object Storage (Cloudflare R2)
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ACCOUNT_ID=

# 5. Push Notifications & Speech APIs
FCM_KEY=
BHASHINI_API_KEY=
OTP_PROVIDER_KEY=

# 6. Weather, Govt Data & AI Providers
WEATHER_PROVIDER=open_meteo
GEMINI_API_KEY=
DATA_GOV_IN_API_KEY=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
OLLAMA_URL=http://localhost:11434

# 7. Model & Knowledge Versioning
MODEL_VERSION=v1.0.0
KNOWLEDGE_VERSION=2026-09-01

# 8. Crop Simulation Engine
DSSAT_BIN_PATH=/usr/local/bin/dscsm048
