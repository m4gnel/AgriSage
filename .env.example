# ==============================================================================
# Agri-SAGE Environment Variables Configuration Example
# Copy this file to .env and fill in the values for your environment.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# 1. Database Configuration
DATABASE_URL=

# 2. Authentication & Security
SECRET_KEY=

# 3. Environment & Operational Settings
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
MAX_IMAGE_SIZE_MB=5

# 4. Object Storage (Cloudflare R2)
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ACCOUNT_ID=

# 5. Push Notifications & Speech APIs
FCM_KEY=
BHASHINI_API_KEY=
OTP_PROVIDER_KEY=

# 6. Weather & AI Providers
WEATHER_PROVIDER=open_meteo
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# 7. AI Model & Knowledge Base Versioning
MODEL_VERSION=v1.0.0
KNOWLEDGE_VERSION=2026-09-01

# 8. Crop Simulation Engine
DSSAT_BIN_PATH=/usr/local/bin/dscsm048

